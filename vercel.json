{
  "version": 2,
  "functions": {
    "api/chat.py": { "maxDuration": 60 },
    "api/question_list.py": { "maxDuration": 60 },
    "api/analyze.py": { "maxDuration": 60 },
    "api/company_search.py": { "maxDuration": 30 },
    "api/export_doc.py": { "maxDuration": 60 },
    "api/create.py": { "maxDuration": 60 },
    "api/match.py": { "maxDuration": 60 },
    "api/report.py": { "maxDuration": 60 },
    "api/upload.py": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/style.css", "destination": "/style.css" },
    { "source": "/app.js", "destination": "/app.js" },
    { "source": "/((?!api/)(?!style\\.css)(?!app\\.js).*)", "destination": "/index.html" }
  ]
}
